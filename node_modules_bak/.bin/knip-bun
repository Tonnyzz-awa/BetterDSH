#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")
basedir_win="$basedir"
exe=""
msys=""

case `uname -a` in
  *CYGWIN*|*MINGW*|*MSYS*)
    if command -v cygpath > /dev/null 2>&1; then
      basedir_win=`cygpath -w "$basedir"`
    fi
    exe=".exe"
    msys="true"
  ;;
  *WSL2*)
    if command -v wslpath > /dev/null 2>&1; then
      basedir_win="$(wslpath -w "$basedir" 2> /dev/null)"
      if [ $? -ne 0 ] || [ -z "$basedir_win" ]; then
        basedir_win="$basedir"
      else
        exe=".exe"
      fi
    fi
  ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/proc/cygdrive/d/Deepseek/dsh-source-code/node_modules/.pnpm/knip@6.16.1/node_modules/knip/node_modules:/proc/cygdrive/d/Deepseek/dsh-source-code/node_modules/.pnpm/knip@6.16.1/node_modules:/proc/cygdrive/d/Deepseek/dsh-source-code/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/proc/cygdrive/d/Deepseek/dsh-source-code/node_modules/.pnpm/knip@6.16.1/node_modules/knip/node_modules:/proc/cygdrive/d/Deepseek/dsh-source-code/node_modules/.pnpm/knip@6.16.1/node_modules:/proc/cygdrive/d/Deepseek/dsh-source-code/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -n "$exe" ] && [ -x "$basedir/bun.exe" ]; then
  exec "$basedir/bun.exe"  "$basedir_win/../knip/bin/knip-bun.js" "$@"
elif [ -x "$basedir/bun" ]; then
  exec "$basedir/bun"  "$basedir/../knip/bin/knip-bun.js" "$@"
elif command -v bun >/dev/null 2>&1; then
  exec bun  "$basedir/../knip/bin/knip-bun.js" "$@"
elif [ -n "$exe" ] && command -v bun.exe >/dev/null 2>&1; then
  exec bun.exe  "$basedir_win/../knip/bin/knip-bun.js" "$@"
else
  exec bun  "$basedir/../knip/bin/knip-bun.js" "$@"
fi
